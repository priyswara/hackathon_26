# GraminArogya Environment Variables
# Copy this file to .env for local development:
# cp .env.example .env

# Resend API Key for sending real verification emails (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Custom sender email (defaults to onboarding@resend.dev for free testing)
# RESEND_FROM_EMAIL=GraminArogya <auth@yourverifieddomain.com>

# Server Port (default: 8080)
PORT=8080
